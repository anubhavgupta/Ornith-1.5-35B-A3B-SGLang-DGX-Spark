# Tuned DFlash config for ./start-dflash.sh (tracked in git).
#
# Loaded automatically by start-dflash.sh. Precedence (highest first):
#   1. shell env vars already exported
#   2. ./.env (local, untracked)
#   3. this file
#   4. start.sh / start-dflash.sh defaults
# See .env.sample for what every variable does.
#
# Measured 2026-10-04 on DGX Spark (GB10, image dev-cu13 @ 035f29e9):
#   KV pool 3,145,776 tokens = 12 x full 262K context, 374 GDN slots
#   (48 for 12 running requests + 326 prefix cache), ~7-8 GB MemAvailable.
#   Concurrency 1: ~113 tok/s decode, DFlash accept length ~2.8.

# Context: native 262K, no YaRN (YaRN is refused with a draft model).
YARN=0
CONTEXT_LENGTH=262144

# 12 requests, each able to reach the full 262K at once.
MAX_CONCURRENT_REQUESTS=12
MEM_FRACTION_STATIC=0.92

# GDN pool: KV capped at 12 x context, rest of the budget = prefix-cache slots.
MAMBA_POOL_MODE=fill
POOL_OVERHEAD_GIB=7.1
FILL_MARGIN_GIB=0.5

# Sparkrun recipe settings.
CHUNKED_PREFILL=4096
MOE_RUNNER_BACKEND=flashinfer_cutlass
LOAD_FORMAT=auto
DROP_CACHES=1

# DFlash2 draft (jzinno/Ornith-1.5-35B-A3B-DFlash2).
# 4 draft tokens: best on chat/essay; 10 is ~15% faster on code/math but
# ~15% slower on chat. The draft window stays off: this image still
# allocates the full draft KV pool with it on, so it saves no memory.
DF_BLOCK_SIZE=4
DF_MAMBA_STRATEGY=extra_buffer_lazy
#DF_DRAFT_WINDOW=4096
