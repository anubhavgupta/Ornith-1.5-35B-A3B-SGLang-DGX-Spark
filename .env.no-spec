# Tuned no-spec config for ./start.sh run directly (tracked in git).
#
# Loaded automatically by start.sh when no spec wrapper (start-dflash.sh,
# start-mtp.sh) launched it. Precedence (highest first):
#   1. shell env vars already exported
#   2. ./.env (local, untracked)
#   3. this file
#   4. start.sh defaults
# See .env.sample for what every variable does.
#
# Measured 2026-10-04 on DGX Spark (GB10, image dev-cu13 @ 035f29e9):
#   KV pool 7,864,320 tokens = 30 x full 262K context (75 GiB fp8),
#   165 GDN slots (120 for 30 running requests + 45 prefix cache),
#   ~9 GB MemAvailable.

# Context: native 262K, no YaRN.
YARN=0
CONTEXT_LENGTH=262144

# 30 requests, each able to reach the full 262K at once.
MAX_CONCURRENT_REQUESTS=30
MEM_FRACTION_STATIC=0.92

# GDN pool: KV capped at 30 x context, rest of the budget = prefix-cache slots.
MAMBA_POOL_MODE=fill
POOL_OVERHEAD_GIB=7.1
FILL_MARGIN_GIB=0.5

# Sparkrun recipe settings.
CHUNKED_PREFILL=4096
MOE_RUNNER_BACKEND=flashinfer_cutlass
LOAD_FORMAT=auto
DROP_CACHES=1
