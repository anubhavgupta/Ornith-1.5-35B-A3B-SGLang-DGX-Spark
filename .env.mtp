# Tuned MTP config for ./start-mtp.sh (tracked in git).
#
# Loaded automatically by start-mtp.sh. Precedence (highest first):
#   1. shell env vars already exported
#   2. ./.env (local, untracked)
#   3. this file
#   4. start.sh / start-mtp.sh defaults
# See .env.sample for what every variable does.
#
# Measured 2026-10-04 on DGX Spark (GB10, image dev-cu13 @ 035f29e9):
#   KV pool 6,815,848 tokens = 26 x full 262K context (71.5 GiB fp8 incl.
#   the 1 KB/token MTP draft KV), 171 GDN slots (104 for 26 running
#   requests + 67 prefix cache), ~5.2 GB MemAvailable (4.3 GB at boot).
#   26 is the max at 0.92: 28 leaves only 1.8 GB free and start.sh refuses it.
#   c=26: 497 tok/s total on mixed prompts, 613 tok/s on code.

# --- Context ---
# YARN: 1 = stretch RoPE with YaRN past the native window; 0 = off.
#   Off here: native 262K is enough.
YARN=0
# CONTEXT_LENGTH: max tokens per request (prompt + output). 262144 = native max.
CONTEXT_LENGTH=262144

# --- Concurrency and memory ---
# MAX_CONCURRENT_REQUESTS: max requests decoding at once (--max-running-requests).
#   The KV pool is sized so every one of them can hold a full CONTEXT_LENGTH.
#   Extra requests queue until a slot frees up.
MAX_CONCURRENT_REQUESTS=26
# MEM_FRACTION_STATIC: share of GPU memory SGLang reserves for weights + KV +
#   GDN pools (--mem-fraction-static). 0.92 leaves ~5 GB for the OS here.
#   Do not go above 0.93 on GB10: 0.95 has hard-frozen the box.
MEM_FRACTION_STATIC=0.92

# --- GDN (mamba) state pool ---
# MAMBA_POOL_MODE: how memory is split between KV cache and GDN state slots.
#   fill  = KV capped at MAX_CONCURRENT_REQUESTS x CONTEXT_LENGTH; everything
#           left goes to GDN slots (extra slots = linear-attention prefix cache).
#   auto  = let SGLang split by its default ratio (more KV, very few slots).
#   pin   = exactly enough slots for the running requests, no prefix cache.
#   ratio = use MAMBA_FULL_MEMORY_RATIO.
MAMBA_POOL_MODE=fill
# POOL_OVERHEAD_GIB: memory SGLang uses outside the KV/GDN pools (CUDA graphs,
#   activations, buffers). Fill mode subtracts it before sizing slots.
#   Calibrated from a measured boot; raise it if the server OOMs at startup.
POOL_OVERHEAD_GIB=7.1
# FILL_MARGIN_GIB: extra safety headroom subtracted in fill mode.
FILL_MARGIN_GIB=0.5

# --- Runtime ---
# CHUNKED_PREFILL: prompts are prefilled in chunks of this many tokens
#   (--chunked-prefill-size). Smaller = less peak memory and smoother decode
#   for other streams while a long prompt prefills; larger = faster prefill.
CHUNKED_PREFILL=4096
# MOE_RUNNER_BACKEND: kernel for the NVFP4 MoE layers. flashinfer_cutlass is
#   required on SM121; "auto" crashes on this model.
MOE_RUNNER_BACKEND=flashinfer_cutlass
# LOAD_FORMAT: weight loader. auto = standard safetensors. fastsafetensors
#   loads faster but holds ~21 GB extra during load.
LOAD_FORMAT=auto
# DROP_CACHES: 1 = drop the Linux page cache before launch so the unified
#   memory is actually free for the GPU pools.
DROP_CACHES=1

# --- MTP speculative decoding (the checkpoint's own 1-layer MTP head) ---
# No extra download: SGLang loads the mtp.* weights from the target checkpoint
# and runs them via --speculative-algorithm EAGLE (chain drafting, topk=1).
# MTP_STEPS: draft forward passes per step (--speculative-num-steps).
MTP_STEPS=3
# MTP_DRAFT: draft tokens verified per step (--speculative-num-draft-tokens).
#   Must equal MTP_STEPS + 1 with topk=1.
MTP_DRAFT=4
